# Vultr Serverless Inference (OpenAI-compatible). Leave the key empty to run with the built-in rule-based agent.
VULTR_INFERENCE_KEY=
VULTR_INFERENCE_URL=https://api.vultrinference.com/v1
DECOY_MODEL=glm-5.3
DECOY_VISION_MODEL=glm-5.3

# Sandbox: "docker" (isolated, default) or "local" (UNSAFE, dev only, our own demo pages only)
DECOY_SANDBOX=docker
DECOY_SANDBOX_IMAGE=decoy-sandbox:latest
# Optional on a Linux VM with gVisor installed: runsc
DECOY_SANDBOX_RUNTIME=

# Budget guard (never remove)
MAX_CALLS_PER_SCAN=12
MAX_SECONDS_PER_SCAN=120
MAX_CALLS_PER_DAY=300
MAX_USD_PER_DAY=2.00
PRICE_IN_PER_M=0.55
PRICE_OUT_PER_M=2.75
MAX_PARALLEL_SCANS=2
KILL_SWITCH=0
